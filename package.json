{
  "name": "machora",
  "version": "0.8.1",
  "description": "Orchestrate Git-native development jobs across your Macs, Windows PCs, and Linux machines.",
  "author": {
    "name": "Jason.z",
    "email": "ccnuzxg@gmail.com",
    "url": "https://github.com/jasonz1987"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonz1987/machora.git"
  },
  "homepage": "https://github.com/jasonz1987/machora#readme",
  "bugs": {
    "url": "https://github.com/jasonz1987/machora/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "remote-development",
    "task-runner",
    "build-orchestration",
    "git",
    "developer-tools"
  ],
  "type": "module",
  "files": [
    "agent",
    "bin",
    "dist",
    "lib",
    "server",
    "README.md"
  ],
  "bin": {
    "machora": "./bin/machora.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "prepack": "npm run build",
    "start": "node bin/machora.mjs server",
    "machora": "node bin/machora.mjs",
    "rdev": "node bin/rdev.mjs",
    "test": "node --test tests/store.test.mjs tests/controller.test.mjs tests/controller-service.test.mjs tests/server.test.mjs tests/agent.test.mjs tests/git-hooks.test.mjs tests/project-inspector.test.mjs tests/project-skill.test.mjs tests/native-dialog.test.mjs tests/dashboard.test.mjs tests/notifier.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^0.468.0",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
